# Copy to .env and adjust. jobq reads these from the process environment.
# NEVER commit real secrets.

# --- Storage backend ---------------------------------------------------------
# Default: SQLite (race-safe via BEGIN IMMEDIATE + atomic UPDATE ... RETURNING).
DATABASE_URL=sqlite:///./jobq.db
# Production: PostgreSQL (FOR UPDATE SKIP LOCKED). Requires the `postgres` extra.
# DATABASE_URL=postgresql://jobq:jobq@localhost:5432/jobq

# --- Worker pool -------------------------------------------------------------
JOBQ_CONCURRENCY=4
JOBQ_POLL_INTERVAL=0.05
JOBQ_HEARTBEAT_INTERVAL=1.0

# --- Reaper (crash recovery) -------------------------------------------------
JOBQ_REAP_INTERVAL=1.0
JOBQ_HEARTBEAT_TIMEOUT=5.0

# --- Dashboard ---------------------------------------------------------------
JOBQ_DASHBOARD_HOST=127.0.0.1
JOBQ_DASHBOARD_PORT=8000
